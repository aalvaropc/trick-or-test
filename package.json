{
  "name": "trick-or-test-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Audit the tests your AI agent writes: breed a monster from every promise in your Kiro spec and see which ones survive.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm test",
    "guard": "node scripts/guard.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "lefthook": false
  }
}
