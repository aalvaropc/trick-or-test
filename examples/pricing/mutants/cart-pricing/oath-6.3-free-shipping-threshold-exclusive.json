{
  "id": "oath-6.3-free-shipping-threshold-exclusive",
  "requirement": "6.3",
  "file": "src/price.ts",
  "original": "discounted >= FREE_SHIPPING_THRESHOLD",
  "mutated": "discounted > FREE_SHIPPING_THRESHOLD",
  "why": "Standard shipping is still charged when the Discounted_Subtotal is exactly 10000.",
  "witness": {
    "from": "src/index.ts",
    "export": "priceCart",
    "args": [{ "lines": [{ "quantity": 1, "unitPriceCents": 10000 }], "shipping": "standard", "taxBps": 0 }],
